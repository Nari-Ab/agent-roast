{
  "name": "agent-roast",
  "version": "0.15.0",
  "description": "Stops AI coding agents (and rushed humans) from turning a build green by weakening tests, coverage gates or CI. Hook for Claude Code, Codex and Cursor, pre-commit, GitHub Action. Offline.",
  "mcpName": "io.github.Nari-Ab/agent-roast",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-roast": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "schema.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "bench": "node scripts/benchmark-recall.mjs",
    "bench:noise": "node scripts/benchmark-noise.mjs"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "ai-coding",
    "llm",
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "hooks",
    "guardrails",
    "code-review",
    "testing",
    "test-quality",
    "github-actions",
    "pre-commit",
    "ci",
    "static-analysis",
    "sarif",
    "git",
    "cli"
  ],
  "author": "Nari-Ab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nari-Ab/agent-roast.git"
  },
  "bugs": {
    "url": "https://github.com/Nari-Ab/agent-roast/issues"
  },
  "homepage": "https://github.com/Nari-Ab/agent-roast#readme",
  "dependencies": {
    "commander": "^12.0.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "vite": "^7.3.7"
  }
}
