{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Nari-Ab/agent-roast/main/schema.json",
  "title": "Agent Roast configuration",
  "description": "Offline review policy. Changes are policy changes and require human review.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "failOn": {
      "description": "Enabled rules which block; an empty array is advisory.",
      "type": "array",
      "items": {
        "enum": [
          "test-skip",
          "type-escape",
          "swallowed-error",
          "panic-loop",
          "trivial-assert",
          "stub-abandonment",
          "test-focus"
        ]
      }
    },
    "ignorePaths": {
      "description": "Repository-relative simple glob or directory-prefix exclusions.",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      },
      "maxItems": 1000
    },
    "scoreThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "panicLoopWindowMinutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test-skip": {
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "type-escape": {
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "swallowed-error": {
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "panic-loop": {
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "trivial-assert": {
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "stub-abandonment": {
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "test-focus": {
          "enum": [
            "error",
            "warn",
            "off"
          ]
        }
      }
    },
    "exceptions": {
      "description": "Precise, reviewed allowances. A new duplicate beyond count remains actionable; expiry includes its UTC date.",
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fingerprint",
          "count",
          "reason",
          "expires"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069]*$"
          },
          "expires": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  }
}
